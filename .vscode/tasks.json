{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Digital Autoimmune Monitor",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File .\\build.ps1",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Run Digital Autoimmune Monitor",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File .\\run.ps1",
            "group": "none"
        }
    ]
}
